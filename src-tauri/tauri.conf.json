{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Switchboard",
  "version": "0.1.0",
  "identifier": "com.cuihongran.codex-switchboard",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Switchboard",
        "width": 980,
        "height": 640,
        "minWidth": 860,
        "minHeight": 580,
        "decorations": true,
        "transparent": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/tray.png"]
  }
}
