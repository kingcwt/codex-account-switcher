{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Account Switcher",
  "version": "0.1.3",
  "identifier": "com.cuihongran.codex-account-switcher",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Account Switcher",
        "width": 980,
        "height": 640,
        "minWidth": 860,
        "minHeight": 580,
        "decorations": true,
        "transparent": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/tray.png"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kingcwt/codex-account-switcher/releases/latest/download/latest.json"
      ],
      "pubkey": "__TAURI_UPDATER_PUBKEY__"
    }
  }
}
